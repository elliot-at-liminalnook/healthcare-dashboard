# Copy to .env to override the defaults used by docker-compose.yml.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthcare

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=8080
GRAFANA_PORT=3000

# Where the backend and the browser send logs and traces (OTLP over HTTP).
# Defaults to the bundled Grafana stack. Set to empty to turn export off.
OTLP_ENDPOINT=http://lgtm:4318
